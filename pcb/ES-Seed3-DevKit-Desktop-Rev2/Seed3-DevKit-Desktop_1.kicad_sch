	(text "This will drop a fair amount of voltage\nMeasured at ~7.86V on a similar circuit on Pedal Dev Kit Rev2"
		(exclude_from_sim no)
		(at 198.882 101.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "07f4d8e5-dc66-4900-b24f-20add71be0e4")
	)
	(text "Selecting R2 with formula:\nR2 = (Vout/Vref - 1) x R1\nWhere Vref = 1.255V\n\nFor Vout: where R1 = 10K and R2 = 62K\n(R2/R1)+1 * Vref = Vout\n\nVout = 9.036V\n(or if my algebra was wrong, it would be.. 8.781V)\nEither is totally fine .. and they're pretty close in this case."
		(exclude_from_sim no)
		(at 71.374 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "31fd2683-fa2f-4f16-ac11-1ad82ef8f5f1")
	)
