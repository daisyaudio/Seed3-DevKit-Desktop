	(text "USB C"
		(exclude_from_sim no)
		(at 245.11 12.954 0)
		(effects
			(font
				(size 3.81 3.2385)
			)
			(justify left bottom)
		)
		(uuid "472a4235-bf7c-48a0-beab-1f4f96863940")
	)
	(text "For this board we may want to use the inductor\nif it helps avoid excess voltage drop..\nIt'd be nice to have the addt'l filter stage\nprior to the seed in addition to one that cleans \nup the USB a bit to make +5V_FILT"
		(exclude_from_sim no)
		(at 47.244 46.482 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "85a088a3-0028-4bdf-b078-e40c82078f15")
	)
	(text "Unlike buttons connected directly to the Seed,\nbuttons connected via Shift register will need\npull up resistors to 3v3 for each button.\nThese can be found next to each button on the\nPeripherals Page."
		(exclude_from_sim no)
		(at 194.818 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a4b35dbd-898b-4147-84c0-adb9cac6aedb")
	)
